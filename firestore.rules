rules_version = '2';

// Bu kurallar repoda durması yetmez — Firebase'e deploy edilmesi gerekir:
//   Firebase Console > Firestore Database > Rules sekmesine yapıştır > Publish
//   veya: npx firebase-tools deploy --only firestore:rules --project <PROJE_ID>
//
// Mantık: ziyaretçiler sadece yeni kayıt EKLEYEBİLİR; kimse (sen dahil, istemci
// tarafından) mesajları/promptları OKUYAMAZ, DEĞİŞTİREMEZ, SİLEMEZ. Sen kayıtları
// Firebase Console'dan görmeye devam edersin (Console kurallardan etkilenmez).
service cloud.firestore {
  match /databases/{database}/documents {

    function isBoundedString(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }

    // Chatbot'a sorulan sorular
    match /prompts/{promptId} {
      allow create: if request.resource.data.keys().hasOnly(['text', 'createdAt', 'platform'])
        && request.resource.data.keys().hasAll(['text', 'createdAt', 'platform'])
        && isBoundedString(request.resource.data.text, 1, 600)
        && isBoundedString(request.resource.data.platform, 0, 500)
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // İletişim formu
    match /contacts/{contactId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'firstName', 'lastName', 'message', 'createdAt', 'platform'])
        && request.resource.data.keys().hasAll(['email', 'firstName', 'lastName', 'message', 'createdAt', 'platform'])
        && isBoundedString(request.resource.data.firstName, 1, 80)
        && isBoundedString(request.resource.data.lastName, 1, 80)
        && isBoundedString(request.resource.data.email, 3, 254)
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && isBoundedString(request.resource.data.message, 1, 5000)
        && isBoundedString(request.resource.data.platform, 0, 500)
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Ziyaretçi sayacı: herkes okuyabilir, ama sadece +1 artırabilir
    // (sayacı 999999 yapmak veya sıfırlamak engellenir).
    match /stats/visitors {
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
      allow list, delete: if false;
    }

    // Geri kalan her şey kapalı
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
